# Local development needs only SETUP_TOKEN. Run npm run setup:key to generate it.
SETUP_TOKEN=

# MongoDB: keep the password separate. The server URL-encodes it at runtime.
MONGODB_URI=mongodb+srv://devwithsmile:<db_password>@cluster0.u0ld7hk.mongodb.net/
MONGO_PASSWORD=passwordExample
MONGODB_DATABASE=our_notes
# Use a separate database (our_notes_preview) for preview deployments.

# Optional local JSON development. This overrides MongoDB locally; not allowed on Vercel.
# NOTES_FILE=./data/notes.json

# Optional canonical origin if a proxy changes the browser-facing Host.
# APP_URL=https://your-project.vercel.app

# Legacy Blob credentials are used only for explicit migration scripts, not hosting.
# BLOB_READ_WRITE_TOKEN=
# NOTES_BLOB_PATH=our-notes/production/notebook.json

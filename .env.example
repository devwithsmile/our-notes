# Local development needs only SETUP_TOKEN. Run npm run setup:key to generate it.
SETUP_TOKEN=

# Vercel: connect a PRIVATE Blob store and add its read/write token to the project.
# Leave unset locally to use data/notes.json.
# BLOB_READ_WRITE_TOKEN=

# Optional: Vercel's connected-store OIDC authentication also works when both
# BLOB_STORE_ID and VERCEL_OIDC_TOKEN are available. No NEXT_PUBLIC_ secrets.

# Optional Blob pathname. Defaults to our-notes/production/notebook.json.
# Vercel preview deployments default to our-notes/preview/notebook.json.
# Prefer a separate private store for previews.
# NOTES_BLOB_PATH=our-notes/production/notebook.json

# Optional local file path. Never place it in public/. Not allowed on Vercel.
# NOTES_FILE=./data/notes.json

# Optional canonical origin if a proxy changes the browser-facing Host.
# APP_URL=https://your-project.vercel.app
